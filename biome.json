{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "root": true,
  "files": {
    "includes": ["**", "!.agents", "!.nitro", "!.output"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["./**", "../**"]
              }
            ]
          }
        }
      }
    }
  },
  "formatter": {
    "lineWidth": 120,
    "indentStyle": "space",
    "indentWidth": 2
  }
}
