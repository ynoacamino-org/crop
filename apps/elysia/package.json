{
  "name": "crop-elysia",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir .output --target bun",
    "start": "bun run .output/index.js",
    "lint": "biome check --write",
    "typecheck": "tsgo --noEmit",
    "codegen": "bun run scripts/gen-schema.ts && graphql-codegen --config codegen.ts && bun scripts/post-codegen.ts",
    "db:seed": "bun run scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@typescript/native-preview": "latest",
    "@faker-js/faker": "^10.1.0",
    "@graphql-codegen/add": "^6.0.0",
    "@graphql-codegen/typed-document-node": "^6.1.5",
    "@graphql-codegen/typescript": "^5.0.7",
    "@graphql-codegen/typescript-operations": "^5.0.7",
    "@graphql-codegen/typescript-urql": "^4.0.1",
    "@repo/biome-config": "workspace:^",
    "@types/bun": "latest",
    "drizzle-kit": "^1.0.0-beta.22"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysia/cors": "^1.2.0",
    "@elysia/graphql-yoga": "^1.2.0",
    "@elysiajs/swagger": "^1.3.1",
    "@graphql-codegen/cli": "^6.1.0",
    "@libsql/client": "^0.17.4",
    "@paralleldrive/cuid2": "^3.0.6",
    "@pothos/core": "^4.10.1",
    "@pothos/plugin-drizzle": "^0.17.1",
    "@pothos/plugin-scope-auth": "^4.1.6",
    "@pothos/plugin-validation": "^4.2.0",
    "@repo/schemas": "workspace:^",
    "@upstash/redis": "^1.38.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.4.9",
    "drizzle-orm": "^1.0.0-beta.22",
    "elysia": "^1.2.25",
    "graphql": "^16.12.0",
    "graphql-scalars": "^1.25.0",
    "graphql-yoga": "^5.18.0",
    "jose": "^6.1.3",
    "zod": "^4.2.1"
  }
}
